# ShipNest Environment Configuration
# Duplicate this file to .env and provide your project variables.
# Do NOT commit actual secrets or production keys to version control.

# Supabase API Configuration (Optional - falls back to localStorage mock persistence if omitted)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id
