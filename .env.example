# ShipNest Environment Configuration
# Duplicate this file to .env and configure local variables.
# Do NOT commit actual secrets or production keys to version control.

# Supabase Client Configuration (Public anon key for client-side queries)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Server-Side Supabase Edge Functions Secrets (Set via: supabase secrets set KEY=VALUE)
# Google Gemini 3.8 Flash API key for nest-chat and review-summary Edge Functions
GEMINI_API_KEY=your-google-gemini-api-key

# Product Image Discovery & Verification (Developer/Admin CLI script)
SERPAPI_API_KEY=your-serpapi-key-optional
