# ==============================================================================
# ShipNest Environment Configuration Guide
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# FOR PRODUCTION (Vercel, Netlify, Cloudflare Pages):
# Set these variables in your hosting provider's Dashboard (Settings -> Environment Variables).
# Never commit .env or live production secrets to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Frontend Client Configuration (Required for Live Auth & User Accounts)
# ------------------------------------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
# - VITE_SUPABASE_URL: Project URL (e.g. https://xyzcompany.supabase.co)
# - VITE_SUPABASE_PUBLISHABLE_KEY: Project API anon/public key (safe for browser)
# - VITE_SUPABASE_PROJECT_ID: Supabase Project Reference ID
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# ------------------------------------------------------------------------------
# 2. Supabase Auth Configuration (Dashboard Setting)
# ------------------------------------------------------------------------------
# In Supabase Dashboard -> Authentication -> URL Configuration:
# - Site URL:
#     Production: https://your-domain.vercel.app (or custom domain)
#     Local Dev:  http://localhost:5173
# - Additional Redirect URLs (Add both production and localhost for smooth OAuth/magic links):
#     https://your-domain.vercel.app/account
#     https://your-domain.vercel.app/auth
#     http://localhost:5173/account
#     http://localhost:5173/auth
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 3. Optional Admin Security
# ------------------------------------------------------------------------------
# Custom password for the internal administrative operations panel (/admin)
# Defaults to "shipnest2024" if not specified.
VITE_ADMIN_PASSWORD=your-secure-admin-password

# ------------------------------------------------------------------------------
# 4. Edge Functions & Developer Tooling (Server-Side Only - NOT exposed in Vite)
# ------------------------------------------------------------------------------
# Set via: supabase secrets set GEMINI_API_KEY=xxx
GEMINI_API_KEY=your-google-gemini-api-key

# Optional CLI key for running offline image discovery scripts
SERPAPI_API_KEY=your-serpapi-key-optional
